# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mrhome?retryWrites=true&w=majority

# Auth
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Admin logins expire sooner (default 12h)
ADMIN_JWT_EXPIRES_IN=12h

# Extra comma-separated frontends allowed to call the API
# (localhost:5173/5174 and the deployed admin/user Vercel URLs are always allowed)
CLIENT_URLS=

# Public base URL of this API (used to build uploaded image URLs)
PUBLIC_URL=http://localhost:5000

# Optional: secret for GET /api/notifications/cron, which an external cron service can call
# (with header "Authorization: Bearer <CRON_SECRET>") so scheduled notifications fire on time
CRON_SECRET=

# First admin account, created by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@mrhome.com
# Use a long unique password (8-72 chars). Never deploy with this example value.
ADMIN_PASSWORD=Admin@123
