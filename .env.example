# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mrhome?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontends allowed to call the API
CLIENT_URLS=http://localhost:5173,http://localhost:5174

# Public base URL of this API (used to build uploaded image URLs)
PUBLIC_URL=http://localhost:5000

# First admin account, created by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@mrhome.com
ADMIN_PASSWORD=Admin@123
